---
import type { ProjectEntry } from '../lib/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const {
  title,
  year,
  media,
  type,
  roles,
  techniques,
  context,
  scope,
  clientArtist,
  thumbnail,
} = project.data;

const displayTitle = clientArtist ? `${clientArtist} — ${title}` : title;

const filterData = JSON.stringify({
  id: project.data.id,
  slug: project.data.slug,
  year,
  media,
  type,
  roles,
  techniques,
  context,
  scope,
  clientArtist,
});
---

<article class="project-card" data-project-card data-project={filterData}>
  <a
    class="project-link"
    href={`/${project.data.slug}`}
    aria-label={`${displayTitle}, ${type}`}
  >
    <figure class="project-visual">
      {
        thumbnail ? (
          <img
            src={thumbnail.src}
            alt={thumbnail.alt}
            loading="lazy"
            style={thumbnail.aspectRatio
              ? `aspect-ratio: ${thumbnail.aspectRatio}`
              : undefined}
          />
        ) : (
          <div class="visual-placeholder" aria-hidden="true" />
        )
      }
    </figure>
    <div class="project-card-copy">
      <h2>{displayTitle}</h2>
      <p class="project-type">{type}</p>
    </div>
  </a>
</article>
