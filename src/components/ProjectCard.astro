---
import type { ProjectEntry } from '../lib/projects';
import {
  taxonomyLabel,
  toFilterProject,
} from '../lib/project-metadata.mjs';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const {
  title,
  type,
  clientArtists,
  thumbnail,
} = project.data;

const artistDisplay = clientArtists.join(', ');
const displayTitle = artistDisplay ? `${artistDisplay} — ${title}` : title;
const typeLabel = taxonomyLabel(type);
const filterData = JSON.stringify(toFilterProject(project.data));
---

<article class="project-card" data-project-card data-project={filterData}>
  <a
    class="project-link"
    href={`/${project.data.slug}`}
    aria-label={`${displayTitle}, ${typeLabel}`}
  >
    <figure class="project-visual">
      {
        thumbnail ? (
          <img
            src={thumbnail.src}
            alt={thumbnail.alt}
            loading="lazy"
            style={thumbnail.aspectRatio
              ? `aspect-ratio: ${thumbnail.aspectRatio}`
              : undefined}
          />
        ) : (
          <div class="visual-placeholder" aria-hidden="true" />
        )
      }
    </figure>
    <div class="project-card-copy">
      <h2>{displayTitle}</h2>
      <p class="project-type">{typeLabel}</p>
    </div>
  </a>
</article>
