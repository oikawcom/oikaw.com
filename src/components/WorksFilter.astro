---
import {
  createEmptySelection,
  filterGroups,
  prospectiveCount,
} from '../lib/works-filter.mjs';

interface FilterProject {
  id: string;
  slug: string;
  year?: number;
  month?: number;
  media: string;
  type: string;
  roles: string[];
  techniques: string[];
  context?: string;
  scope?: string;
  clientArtists: string[];
  series?: string;
}

interface Props {
  projects: FilterProject[];
  instanceId?: string;
  includeDynamic?: boolean;
}

const {
  projects,
  instanceId = 'desktop',
  includeDynamic = false,
} = Astro.props;
const emptySelection = createEmptySelection();
const uniqueValues = (values: (string | undefined)[]) =>
  [...new Set(values.filter((value): value is string => Boolean(value)))];
const dynamicGroups = [
  {
    key: 'clientArtist',
    label: 'CLIENT / ARTIST',
    values: uniqueValues(projects.flatMap(({ clientArtists }) => clientArtists))
      .sort((left, right) => left.localeCompare(right, 'ja')),
  },
  {
    key: 'year',
    label: 'YEAR',
    values: uniqueValues(projects.map(({ year }) => year ? String(year) : undefined))
      .sort((left, right) => Number(right) - Number(left)),
  },
  {
    key: 'series',
    label: 'SERIES / COLLECTION',
    values: uniqueValues(projects.map(({ series }) => series))
      .sort((left, right) => left.localeCompare(right, 'ja')),
  },
];
const groups = includeDynamic ? [...filterGroups, ...dynamicGroups] : filterGroups;
---

<section
  class="works-filter"
  aria-labelledby="works-filter-heading"
  data-filter-root
  data-projects={JSON.stringify(projects)}
>
  <h2 id="works-filter-heading" class="visually-hidden">Filter works</h2>
  <div class="filter-scroll-frame">
    <div
      class="filter-scroll-region"
      tabindex="0"
      aria-label="Project filters"
      data-filter-scroll
    >
      {
        groups.map(({ key, label, values }) => {
          const panelId = `${instanceId}-filter-panel-${key}`;

          return (
            <section class="filter-group" data-filter-group={key}>
              <h3>
                <button
                  class="filter-group-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-filter-toggle
                >
                  <span aria-hidden="true" data-filter-symbol>+</span>
                  {label}
                </button>
              </h3>
              <div class="filter-tag-list" id={panelId} hidden data-filter-panel>
                {values.map((value) => {
                  const count = prospectiveCount(
                    projects,
                    emptySelection,
                    key,
                    value,
                  );

                  return (
                    <button
                      class="filter-tag"
                      type="button"
                      aria-pressed="false"
                      disabled={count === 0}
                      data-filter-tag
                      data-category={key}
                      data-value={value}
                    >
                      <span class="filter-tag-count" data-filter-count>{count}</span>
                      <span>{value}</span>
                    </button>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </div>
    <div class="filter-scroll-fade" aria-hidden="true" data-filter-fade></div>
  </div>
</section>
