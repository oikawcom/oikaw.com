---
import type { GetStaticPaths } from 'astro';
import FilterTray from '../components/FilterTray.astro';
import WorksFilter from '../components/WorksFilter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  projectMetadataLabels,
  taxonomyFilterValue,
  taxonomyLabel,
  toFilterProject,
} from '../lib/project-metadata.mjs';
import { getAllProjects, type ProjectEntry } from '../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getAllProjects();
  const filterProjects = projects
    .filter(({ data }) => data.initialReleaseScope && data.publicationStatus !== 'draft')
    .map(({ data }) => toFilterProject(data));

  return projects.map((project) => ({
    params: { id: project.data.slug },
    props: { project, filterProjects },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: ProjectEntry;
  filterProjects: ReturnType<typeof toFilterProject>[];
}

interface MetadataValue {
  label: string;
  filterValue?: string;
}

interface MetadataEntry {
  label: string;
  values: MetadataValue[];
  category?: string;
}

const { project, filterProjects } = Astro.props;
const {
  title,
  year,
  media: mediaCategory,
  type,
  context,
  scope,
  roles,
  techniques,
  clientArtists,
  seriesCollection,
  images,
  video,
  galleryColumns,
  descriptionJa,
  descriptionEn,
  credits,
  seoTitle,
  seoDescription,
  ogImage,
} = project.data;

const taxonomyValues = (values: unknown[]): MetadataValue[] =>
  values.map((value) => ({
    label: taxonomyLabel(value),
    filterValue: taxonomyFilterValue(value),
  }));
const roleValues = [
  ...taxonomyValues(roles),
  ...(scope === 'solo-production'
    ? [{ label: 'Solo Production', filterValue: 'Solo Production' }]
    : []),
];
const metadata: MetadataEntry[] = [
  {
    label: 'YEAR',
    values: year ? [{ label: String(year), filterValue: String(year) }] : [],
    category: 'year',
  },
  { label: 'MEDIA', values: taxonomyValues([mediaCategory]), category: 'media' },
  { label: 'TYPE', values: taxonomyValues([type]), category: 'type' },
  { label: 'ROLE', values: roleValues, category: 'role' },
  { label: 'TECHNIQUE', values: taxonomyValues(techniques), category: 'technique' },
  {
    label: 'CONTEXT',
    values: context ? [{ label: context, filterValue: context }] : [],
    category: 'context',
  },
  {
    label: 'CLIENT / ARTIST',
    values: clientArtists.map((value) => ({ label: value, filterValue: value })),
    category: 'clientArtist',
  },
  {
    label: 'SERIES / COLLECTION',
    values: seriesCollection
      ? [{ label: seriesCollection, filterValue: seriesCollection }]
      : [],
    category: 'series',
  },
];

if (
  metadata.map(({ label }) => label).join('\u001f') !==
  projectMetadataLabels.join('\u001f')
) {
  throw new Error('Project metadata labels are incomplete or out of order.');
}
---

<BaseLayout
  title={seoTitle ?? `${title} — oikaw.com`}
  description={seoDescription ??
    descriptionEn ??
    descriptionJa ??
    (year ? `${title}, ${year}` : title)}
  ogImage={ogImage}
  activeNav="works"
>
  <WorksFilter slot="sidebar" projects={filterProjects} />

  <div class="detail-filter-toolbar sticky-filter-toolbar">
    <FilterTray context="detail" />
  </div>

  <article class="project-detail">
    <header class="project-heading project-content-container">
      <p class="eyebrow">Project</p>
      <h1>{title}</h1>
    </header>

    <dl class="project-metadata project-content-container">
      {
        metadata.map(({ label, values, category }) => (
          <div data-project-metadata-row>
            <dt data-project-metadata-label>{label}</dt>
            <dd>
              {values.length === 0 ? (
                <span aria-label="Not specified">—</span>
              ) : (
                <span class="detail-filter-values">
                  {values.map(({ label: valueLabel, filterValue }) =>
                    category && filterValue ? (
                      <button
                        class="detail-filter-tag"
                        type="button"
                        aria-pressed="false"
                        data-detail-filter
                        data-category={category}
                        data-value={filterValue}
                      >
                        {valueLabel}
                      </button>
                    ) : (
                      <span>{valueLabel}</span>
                    ),
                  )}
                </span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    {
      (descriptionJa || descriptionEn) && (
        <div class="project-descriptions project-content-container">
          {descriptionJa && <p lang="ja">{descriptionJa}</p>}
          {descriptionEn && <p lang="en">{descriptionEn}</p>}
        </div>
      )
    }

    {
      (images.length > 0 || video) && (
        <section
          class="project-media project-content-container"
          aria-label="Project media"
          style={`--gallery-columns: ${galleryColumns ?? 1}`}
        >
          {video && (
            <figure class="project-video">
              <video
                controls
                poster={video.poster}
                style={video.aspectRatio
                  ? `aspect-ratio: ${video.aspectRatio}`
                  : undefined}
              >
                <source src={video.src} />
              </video>
              {video.caption && <figcaption>{video.caption}</figcaption>}
            </figure>
          )}
          {images.map((item) => (
            <figure>
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                style={item.aspectRatio ? `aspect-ratio: ${item.aspectRatio}` : undefined}
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {
      credits.length > 0 && (
        <section class="project-credits project-content-container" aria-labelledby="credits-heading">
          <h2 id="credits-heading">Credits</h2>
          <dl>
            {credits.map(({ label, name }) => (
              <div>
                <dt>{label}</dt>
                <dd>{name}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>

  <script>
    import { setupFilterTray } from '../lib/filter-tray.mjs';
    import { setupWorksFilter } from '../lib/works-filter-ui.mjs';

    type Selection = Record<string, string[]>;

    const detailTags = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-detail-filter]'),
    ];
    let sidebarController: ReturnType<typeof setupWorksFilter>;

    const updateDetailTags = (draft: Selection) => {
      for (const button of detailTags) {
        const category = button.dataset.category ?? '';
        const value = button.dataset.value ?? '';
        button.setAttribute(
          'aria-pressed',
          String((draft[category] ?? []).includes(value)),
        );
      }
    };

    const trayController = setupFilterTray({
      onDraftChange: ({ draft }: { draft: Selection }) => {
        updateDetailTags(draft);
        sidebarController?.update(draft);
      },
      onApply: () => window.location.assign('/works'),
    });

    if (!trayController) throw new Error('Filter tray could not be initialized.');
    sidebarController = setupWorksFilter({ trayController });
    if (!sidebarController) throw new Error('Works filter could not be initialized.');

    for (const button of detailTags) {
      button.addEventListener('click', () => {
        trayController.toggle(
          button.dataset.category ?? '',
          button.dataset.value ?? '',
        );
      });
    }

    updateDetailTags(trayController.getState().draft as Selection);
  </script>
</BaseLayout>
