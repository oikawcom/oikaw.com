---
import type { GetStaticPaths } from 'astro';
import FilterTray from '../components/FilterTray.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProjects, type ProjectEntry } from '../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getAllProjects();

  return projects.map((project) => ({
    params: { id: project.data.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const {
  title,
  year,
  media: mediaCategory,
  type,
  context,
  scope,
  roles,
  techniques,
  clientArtist,
  seriesCollection,
  images,
  video,
  descriptionJa,
  descriptionEn,
  credits,
  seoTitle,
  seoDescription,
  ogImage,
} = project.data;

interface MetadataEntry {
  label: string;
  values: string[];
  category?: string;
}

const roleValues = [
  ...roles,
  ...(scope === 'solo-production' ? ['Solo Production'] : []),
];
const metadata: MetadataEntry[] = [
  { label: 'Year', values: year ? [String(year)] : [] },
  { label: 'Media', values: [mediaCategory], category: 'media' },
  { label: 'Type', values: [type], category: 'type' },
  { label: 'Context', values: context ? [context] : [], category: 'context' },
  {
    label: 'Client / Artist',
    values: clientArtist ? [clientArtist] : [],
    category: 'clientArtist',
  },
  { label: 'Role', values: roleValues, category: 'role' },
  { label: 'Technique', values: techniques, category: 'technique' },
  { label: 'Series / Collection', values: seriesCollection ? [seriesCollection] : [] },
].filter(({ values }) => values.length > 0);
---

<BaseLayout
  title={seoTitle ?? `${title} — oikaw.com`}
  description={seoDescription ??
    descriptionEn ??
    descriptionJa ??
    (year ? `${title}, ${year}` : title)}
  ogImage={ogImage}
>
  <div class="detail-filter-toolbar">
    <FilterTray context="detail" />
  </div>

  <article class="project-detail">
    <header class="project-heading">
      <p class="eyebrow">Project</p>
      <h1>{title}</h1>
    </header>

    <dl class="project-metadata">
      {
        metadata.map(({ label, values, category }) => (
          <div>
            <dt>{label}</dt>
            <dd>
              {category ? (
                <span class="detail-filter-values">
                  {values.map((value) => (
                    <button
                      class="detail-filter-tag"
                      type="button"
                      aria-pressed="false"
                      data-detail-filter
                      data-category={category}
                      data-value={value}
                    >
                      {value}
                    </button>
                  ))}
                </span>
              ) : (
                values.join(', ')
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    {
      (descriptionJa || descriptionEn) && (
        <div class="project-descriptions">
          {descriptionJa && <p lang="ja">{descriptionJa}</p>}
          {descriptionEn && <p lang="en">{descriptionEn}</p>}
        </div>
      )
    }

    {
      (images.length > 0 || video) && (
        <section class="project-media" aria-label="Project media">
          {video && (
            <figure>
              <video
                controls
                poster={video.poster}
                style={video.aspectRatio
                  ? `aspect-ratio: ${video.aspectRatio}`
                  : undefined}
              >
                <source src={video.src} />
              </video>
              {video.caption && <figcaption>{video.caption}</figcaption>}
            </figure>
          )}
          {images.map((item) => (
            <figure>
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                style={item.aspectRatio ? `aspect-ratio: ${item.aspectRatio}` : undefined}
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {
      credits.length > 0 && (
        <section class="project-credits" aria-labelledby="credits-heading">
          <h2 id="credits-heading">Credits</h2>
          <dl>
            {credits.map(({ label, name }) => (
              <div>
                <dt>{label}</dt>
                <dd>{name}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>

  <script>
    import { setupFilterTray } from '../lib/filter-tray.mjs';

    type Selection = Record<string, string[]>;

    const detailTags = [
      ...document.querySelectorAll<HTMLButtonElement>('[data-detail-filter]'),
    ];
    let trayController: ReturnType<typeof setupFilterTray>;

    const updateDetailTags = ({ draft }: { draft: Selection }) => {
      for (const button of detailTags) {
        const category = button.dataset.category ?? '';
        const value = button.dataset.value ?? '';
        button.setAttribute(
          'aria-pressed',
          String((draft[category] ?? []).includes(value)),
        );
      }
    };

    trayController = setupFilterTray({
      onDraftChange: updateDetailTags,
      onApply: () => window.location.assign('/'),
    });

    if (!trayController) throw new Error('Filter tray could not be initialized.');

    for (const button of detailTags) {
      button.addEventListener('click', () => {
        trayController?.toggle(
          button.dataset.category ?? '',
          button.dataset.value ?? '',
        );
      });
    }

    updateDetailTags(trayController.getState());
  </script>
</BaseLayout>
