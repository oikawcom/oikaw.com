---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProjects, type ProjectEntry } from '../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getAllProjects();

  return projects.map((project) => ({
    params: { id: project.data.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const {
  title,
  year,
  media: mediaCategory,
  type,
  context,
  roles,
  techniques,
  clientArtist,
  seriesCollection,
  images,
  video,
  descriptionJa,
  descriptionEn,
  credits,
  seoTitle,
  seoDescription,
  ogImage,
} = project.data;

const metadata = [
  ['Year', year ? String(year) : undefined],
  ['Media', mediaCategory],
  ['Type', type],
  ['Context', context],
  ['Client / Artist', clientArtist],
  ['Role', roles.length > 0 ? roles.join(', ') : undefined],
  ['Technique', techniques.length > 0 ? techniques.join(', ') : undefined],
  ['Series / Collection', seriesCollection],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<BaseLayout
  title={seoTitle ?? `${title} — oikaw.com`}
  description={seoDescription ??
    descriptionEn ??
    descriptionJa ??
    (year ? `${title}, ${year}` : title)}
  ogImage={ogImage}
>
  <article class="project-detail">
    <header class="project-heading">
      <p class="eyebrow">Project</p>
      <h1>{title}</h1>
    </header>

    <dl class="project-metadata">
      {
        metadata.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    {
      (descriptionJa || descriptionEn) && (
        <div class="project-descriptions">
          {descriptionJa && <p lang="ja">{descriptionJa}</p>}
          {descriptionEn && <p lang="en">{descriptionEn}</p>}
        </div>
      )
    }

    {
      (images.length > 0 || video) && (
        <section class="project-media" aria-label="Project media">
          {video && (
            <figure>
              <video
                controls
                poster={video.poster}
                style={video.aspectRatio
                  ? `aspect-ratio: ${video.aspectRatio}`
                  : undefined}
              >
                <source src={video.src} />
              </video>
              {video.caption && <figcaption>{video.caption}</figcaption>}
            </figure>
          )}
          {images.map((item) => (
            <figure>
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                style={item.aspectRatio ? `aspect-ratio: ${item.aspectRatio}` : undefined}
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {
      credits.length > 0 && (
        <section class="project-credits" aria-labelledby="credits-heading">
          <h2 id="credits-heading">Credits</h2>
          <dl>
            {credits.map(({ label, name }) => (
              <div>
                <dt>{label}</dt>
                <dd>{name}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>
</BaseLayout>
