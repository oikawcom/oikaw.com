---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContent from '../data/site.json';

const { top } = siteContent;
const visual = top.media;
---

<BaseLayout title="oikaw.com" description="Work by Yusuke Oikawa.">
  <section class="top-page" aria-label="Top">
    <figure class="top-main-visual project-content-container">
      {
        visual.kind === 'image' && visual.src ? (
          <img
            src={visual.src}
            alt={visual.alt}
            style={`aspect-ratio: ${visual.aspectRatio}`}
          />
        ) : visual.kind === 'video' && visual.src ? (
          <video
            autoplay
            muted
            loop
            playsinline
            poster={visual.poster ?? undefined}
            aria-label={visual.alt || undefined}
            style={`aspect-ratio: ${visual.aspectRatio}`}
          >
            <source src={visual.src} />
          </video>
        ) : (
          <div
            class="top-visual-placeholder"
            role="img"
            aria-label="Main visual placeholder"
            style={`aspect-ratio: ${visual.aspectRatio}`}
          />
        )
      }
    </figure>
    <p class="top-copyright project-content-container">{top.copyright}</p>
  </section>
</BaseLayout>
